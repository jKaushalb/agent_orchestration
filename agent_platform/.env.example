# Copy to .env and fill in. Loaded by backend via python-dotenv.

# --- Model providers (litellm resolves by model-name prefix) ---
# e.g. an agent with model "gemini/gemini-2.5-flash" uses GEMINI_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tools ---
# Required by the web_search tool (Tavily)
TAVILY_API_KEY=

# --- Telegram channel (Chunk 5) ---
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
