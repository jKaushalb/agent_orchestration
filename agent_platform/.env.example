# Copy to .env and fill in. Loaded by backend via python-dotenv.

# --- Model providers (litellm resolves by model-name prefix) ---
# e.g. an agent with model "gemini/gemini-2.5-flash" uses GEMINI_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tools ---
# Required by the web_search tool (Tavily)
TAVILY_API_KEY=

# --- Throttling ---
# Max concurrent agent LLM calls (lower this if you hit rate limits; default 2).
AGENT_MAX_CONCURRENCY=2

# --- Telegram channel ---
# Create a bot via @BotFather and paste the token here (leave blank to disable)
TELEGRAM_BOT_TOKEN=
# Optional: where an inbound Telegram message enters (defaults to first workflow/agent)
TELEGRAM_ENTRY_WORKFLOW=
TELEGRAM_ENTRY_AGENT=
